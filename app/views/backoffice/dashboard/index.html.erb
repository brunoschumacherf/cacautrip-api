<header class="page-heading"><div><p class="eyebrow">OPERAÇÃO DA PLATAFORMA</p><h1>Visão geral</h1><p>Bem-vindo, <%= current_admin_user.name %>. Acompanhe o que precisa de atenção.</p></div><span class="pill"><%= current_admin_user.admin? ? 'Administração' : 'Atendimento e moderação' %></span></header>
<section class="metrics">
  <% @metrics.each do |label, count| %><article><span><%= label %></span><strong><%= count %></strong></article><% end %>
  <% if current_admin_user.admin? %><article><span>Pagamentos aprovados</span><strong><%= number_to_currency(@gross, unit: 'R$ ', separator: ',', delimiter: '.') %></strong></article><article><span>Comissões acumuladas</span><strong><%= number_to_currency(@fees, unit: 'R$ ', separator: ',', delimiter: '.') %></strong></article><% end %>
</section>
<% if current_admin_user.admin? %>
  <section class="panel"><h2>Equipe e permissões</h2><p>Crie acessos administrativos ou contas para atendimento e moderação.</p><div class="actions"><%= link_to 'Criar administrador', backoffice_new_record_path(resource: 'admin_users', role: 'admin'), class: 'primary' %><%= link_to 'Criar conta de suporte', backoffice_new_record_path(resource: 'admin_users', role: 'suporte'), class: 'secondary' %><%= link_to 'Gerenciar equipe', backoffice_records_path(resource: 'admin_users'), class: 'secondary' %></div></section>
<% end %>
<div class="two-columns">
  <section class="panel"><h2>Chamados aguardando resposta</h2><% if @tickets.empty? %><p class="muted">Tudo em dia no atendimento.</p><% end %><% @tickets.each do |ticket| %><div class="list-row"><div><strong>Chamado #<%= ticket.id %></strong><small>Usuário #<%= ticket.user_id %> · <%= display_value(ticket, :created_at) %></small></div><%= link_to 'Atender', backoffice_support_chat_path(ticket), class: 'secondary' %></div><% end %></section>
  <section class="panel"><h2>Falhas técnicas em aberto</h2><% if @incidents.empty? %><p class="muted">Nenhuma falha registrada em aberto.</p><% end %><% @incidents.each do |incident| %><div class="list-row"><div><strong><%= incident.error_class %></strong><small><%= incident.location %></small></div><%= link_to 'Analisar', backoffice_record_path(resource: 'incidents', id: incident.id), class: 'secondary' %></div><% end %></section>
</div>
<section class="panel"><h2>Próximos passos</h2><div class="actions"><%= link_to 'Atender solicitações', backoffice_support_chats_path, class: 'primary' %><%= link_to 'Revisar denúncias', backoffice_records_path(resource: 'reports'), class: 'secondary' %><% if current_admin_user.admin? %><%= link_to 'Aprovar profissionais', backoffice_records_path(resource: 'guides'), class: 'secondary' %><%= link_to 'Relatórios agregados', backoffice_reports_path, class: 'secondary' %><% end %></div></section>

