<section class="login-card">
  <div class="brand"><img class="brand-image" src="/cacautrip.png" width="42" height="42" alt="Cacau Trip"><span>CACAU TRIP</span></div>
  <p class="eyebrow">ADMINISTRAÇÃO E SUPORTE</p>
  <h1>Acesse sua área de trabalho.</h1>
  <p class="muted">Entre com sua conta de equipe. As contas de turistas e profissionais são independentes deste painel.</p>
  <%= form_with url: backoffice_login_path, local: true do |form| %>
    <%= form.label :email, 'E-mail da equipe' %>
    <%= form.email_field :email, required: true, autocomplete: 'username', value: params[:email], autofocus: true %>
    <%= form.label :password, 'Senha' %>
    <%= form.password_field :password, required: true, autocomplete: 'current-password' %>
    <%= form.submit 'Entrar no painel', class: 'primary full' %>
  <% end %>
</section>
