<header class="page-heading"><div><p class="eyebrow">SUSTENTABILIDADE</p><h1>Validar benefício em parceiro</h1><p>Confira o estabelecimento e as condições com o cliente antes de confirmar o uso. Cupons de trilhas e motoristas são aplicados no pagamento do app.</p></div></header>
<section class="panel form-panel"><%= form_with url: backoffice_eco_vouchers_path, method: :get do |form| %><div class="field"><%= form.label :redemption_code, 'Código apresentado pelo cliente' %><%= form.text_field :redemption_code, value: params[:redemption_code], required: true %></div><%= form.submit 'Consultar cupom', class: 'primary' %><% end %></section>
<% if @voucher %><section class="panel"><h2><%= @voucher.benefit['title'] %></h2><p>Cliente: <%= @voucher.user.name %></p><p><%= @voucher.benefit['description'] %></p><p>Onde usar: <%= @voucher.benefit.dig('partner', 'name') || @voucher.benefit['scope'] %></p><p><%= @voucher.benefit.dig('partner', 'address') %> · <%= @voucher.benefit.dig('partner', 'city') %></p><p>Desconto: <%= @voucher.benefit['discount_value'] %><%= @voucher.benefit['discount_type'] == 'percent' ? '%' : ' reais' %> · Mínimo da compra: R$ <%= @voucher.benefit['minimum_amount'] %></p><% if @voucher.benefit['maximum_discount'] %><p>Limite do desconto: R$ <%= @voucher.benefit['maximum_discount'] %></p><% end %><p>Validade: <%= @voucher.expires_at.in_time_zone('America/Bahia').strftime('%d/%m/%Y %H:%M') %> · Situação: <%= @voucher.expires_at.past? ? 'Expirado' : @voucher.status %></p>
<% if @voucher.status == 'available' && @voucher.expires_at.future? && @voucher.benefit['scope'] == 'partner' %><%= button_to 'Confirmar uso no estabelecimento', backoffice_eco_vouchers_path, params: { redemption_code: @voucher.code }, method: :post, class: 'primary' %><% end %></section><% end %>
